# Copy this file to .env and fill in the values.

DISCORD_BOT_TOKEN=
# Leave as 0 at first. Send the bot any message and it will tell you your ID.
ALLOWED_USER_ID=0

ANTHROPIC_API_KEY=

# The long ID in your sheet's URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=service_account.json

TIMEZONE=America/New_York
DEFAULT_WORKFLOW=crm
DEFAULT_CADENCE_DAYS=30
# small is the default. Try base if transcription is slow, medium if it mishears names.
WHISPER_MODEL=small

# Weekly loop. Format: day HH:MM (24-hour). Use "off" to turn one off.
ROUNDUP_TIME=sun 18:00
NUDGE_TIME=wed 09:00
